+def _prepare_native_assert(tensor):
+    if not _USE_DEVICE_ASSERT or tensor.device.type != "cuda":
+        return
+    device = tensor.device
+    with torch_device_fn.device(device):
+        stream = torch.cuda.current_stream(device)
+        state = _NATIVE_ASSERT_STATES.get(device)
+        if state is None:
+            with _NATIVE_ASSERT_LOCK:
+                state = _NATIVE_ASSERT_STATES.get(device)
+                if state is None:
+                    seed = torch.zeros(1, dtype=torch.int32, device=device)
+                    _check_native_error(seed, 1)
+                    ready = torch.cuda.Event()
+                    ready.record(stream)
+                    state = (seed, ready, stream.cuda_stream)
+                    _NATIVE_ASSERT_STATES[device] = state
+        if stream.cuda_stream != state[2]:
+            # Device-side dependency only; never synchronize or read a CPU flag.
+            stream.wait_event(state[1])
