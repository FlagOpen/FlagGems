{
  "api_version": "v6.0",
  "name": "feature_dropout_",
  "requires_triton_kernel": true,
  "description": "The in-place version of `feature_dropout()`. Randomly zeroes out entire channels\nof the `input` tensor with probability `p`.",
  "parameters": [
    {
      "name": "input",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "p",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "train",
      "kind": "positional_or_keyword",
      "required": false,
      "default": true
    }
  ],
  "outputs": [
    "out"
  ],
  "effects": {
    "mutates": [
      "input"
    ],
    "returns_alias_of": {
      "out": "input"
    }
  }
}
