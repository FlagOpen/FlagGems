{
  "api_version": "v6.0",
  "name": "nll_loss2d_forward",
  "requires_triton_kernel": true,
  "description": "Forward pass of the negative log likelihood loss for a 4D input (N, C, H, W) of\nlog-probabilities and a 3D integer target (N, H, W). Returns the loss tensor\ntogether with the total weight used for the reduction.",
  "parameters": [
    {
      "name": "self",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "target",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "weight",
      "kind": "positional_or_keyword",
      "required": false,
      "default": null
    },
    {
      "name": "reduction",
      "kind": "positional_or_keyword",
      "required": false,
      "default": 1
    },
    {
      "name": "ignore_index",
      "kind": "positional_or_keyword",
      "required": false,
      "default": -100
    }
  ],
  "outputs": [
    "output",
    "total_weight"
  ],
  "effects": {
    "mutates": [],
    "returns_alias_of": {}
  }
}
