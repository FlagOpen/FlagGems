{
  "api_version": "v6.0",
  "name": "nanquantile",
  "requires_triton_kernel": true,
  "description": "Tensor-`q` overload of `nanquantile`. Computes the q-th quantiles along `dim`,\nignoring `NaN` values.",
  "parameters": [
    {
      "name": "inp",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "q",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "dim",
      "kind": "positional_or_keyword",
      "required": false,
      "default": null
    },
    {
      "name": "keepdim",
      "kind": "positional_or_keyword",
      "required": false,
      "default": false
    },
    {
      "name": "interpolation",
      "kind": "positional_or_keyword",
      "required": false,
      "default": "linear"
    }
  ],
  "outputs": [
    "out"
  ],
  "effects": {
    "mutates": [],
    "returns_alias_of": {}
  }
}
