    {
      "name": "self",
      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "Tensor"
    },
    {
      "name": "mat1",
      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "Tensor"
    },
    {
      "name": "mat2",
      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "Tensor"
    },
    {
      "name": "beta",
      "kind": "keyword_only",
      "required": false,
      "default": 1,
      "type_hint": "Scalar"
    },
    {
      "name": "alpha",
      "kind": "keyword_only",
      "required": false,
      "default": 1,
      "type_hint": "Scalar"
    }
  ],
  "outputs": [
    "out"
  ],
  "effects": {
    "mutates": [
      "self"
    ],
    "returns_alias_of": {
      "out": "self"
    }
  }
}
