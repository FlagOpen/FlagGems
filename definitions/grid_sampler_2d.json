{
  "api_version": "v6.0",
  "name": "grid_sampler_2d",
  "requires_triton_kernel": true,
  "description": "Performs 2D grid sampling of the input tensor using the given grid.\nSupports bilinear, nearest, and bicubic interpolation with zeros, border, and reflection padding.",
  "parameters": [
    {
      "name": "input",
      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "torch.Tensor"
    },
    {
      "name": "grid",
      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "torch.Tensor"
    },
    {
      "name": "interpolation_mode",
      "kind": "positional_or_keyword",
      "required": false,
      "default": 0,
      "type_hint": "int"
    },
    {
      "name": "padding_mode",
      "kind": "positional_or_keyword",
      "required": false,
      "default": 0,
      "type_hint": "int"
    },
    {
      "name": "align_corners",
      "kind": "positional_or_keyword",
      "required": false,
      "default": false,
      "type_hint": "bool"
    }
  ],
  "outputs": [
    "out"
  ],
  "effects": {
    "mutates": [],
    "returns_alias_of": {}
  }
}
