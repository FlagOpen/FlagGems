{
  "api_version": "v6.0",
  "name": "scatter_reduce_",
  "requires_triton_kernel": true,
  "description": "In-place aten::scatter_reduce_.two reduction of values from src into self at index positions along dim. Supports sum, prod, mean, amax, and amin, with optional inclusion of the existing destination values.",
  "parameters": [
    {
      "name": "self",
      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "Tensor"
    },
    {
      "name": "dim",
      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "int"
    },
    {
      "name": "index",
      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "Tensor"
    },
    {
      "name": "src",
      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "Tensor"
    },
    {
      "name": "reduce",
      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "str"
    },
    {
      "name": "include_self",
      "kind": "keyword_only",
      "required": false,
      "default": true,
      "type_hint": "bool"
    }
  ],
  "outputs": [
    "out"
  ],
  "effects": {
    "mutates": [
      "self"
    ],
    "returns_alias_of": {
      "out": "self"
    }
  }
}
