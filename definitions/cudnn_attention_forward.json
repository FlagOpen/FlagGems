      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "Tensor"
    },
    {
      "name": "key",
      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "Tensor"
    },
    {
      "name": "value",
      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "Tensor"
    },
    {
      "name": "attn_bias",
      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "Tensor?"
    },
    {
      "name": "cum_seq_q",
      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "Tensor?"
    },
    {
      "name": "cum_seq_k",
      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "Tensor?"
    },
    {
      "name": "max_q",
      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "SymInt"
    },
    {
      "name": "max_k",
      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "SymInt"
    },
    {
      "name": "compute_log_sumexp",
      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "bool"
    },
    {
      "name": "dropout_p",
      "kind": "positional_or_keyword",
      "required": false,
      "default": 0.0,
      "type_hint": "float"
    },
    {
      "name": "is_causal",
      "kind": "positional_or_keyword",
      "required": false,
      "default": false,
      "type_hint": "bool"
    },
    {
      "name": "return_debug_mask",
      "kind": "positional_or_keyword",
      "required": false,
      "default": false,
      "type_hint": "bool"
    },
    {
