{
  "api_version": "v6.0",
  "name": "cudnn_attention_forward",
  "requires_triton_kernel": true,
  "description": "Compute cuDNN-style scaled dot-product attention in BHSD layout and return the output, log-sum-exp statistics, sequence metadata, RNG metadata, and optional debug mask; current FlagGems coverage includes dense causal and biased no-dropout paths and explicit rejection of dropout and variable-length metadata.",
  "parameters": [
    {
