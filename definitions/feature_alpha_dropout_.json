{
  "api_version": "v6.0",
  "name": "feature_alpha_dropout_",
  "requires_triton_kernel": true,
  "description": "Applies feature alpha dropout to the input tensor in-place while preserving the self-normalizing properties of SELU activations.",
  "parameters": [
    {
      "name": "input",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "p",
      "kind": "positional_or_keyword",
      "required": false,
      "default": 0.5
    },
    {
      "name": "train",
      "kind": "positional_or_keyword",
      "required": false,
      "default": true
    }
  ],
  "outputs": [
    "out"
  ],
  "effects": {
    "mutates": [
      "input"
    ],
    "returns_alias_of": {
      "out": "input"
    }
  }
}
