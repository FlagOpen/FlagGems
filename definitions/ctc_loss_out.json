{
  "api_version": "v6.0",
  "name": "ctc_loss_out",
  "requires_triton_kernel": true,
  "description": "The `out` variant of the private `aten::_ctc_loss` overload, writing the negative\nlog likelihood and the log-alpha lattice into `out0` and `out1`.",
  "parameters": [
    {
      "name": "log_probs",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "targets",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "input_lengths",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "target_lengths",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "blank",
      "kind": "positional_or_keyword",
      "required": false,
      "default": 0
    },
    {
      "name": "zero_infinity",
      "kind": "positional_or_keyword",
      "required": false,
      "default": false
    },
    {
